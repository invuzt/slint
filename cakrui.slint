import { ScrollView, VerticalBox } from "std-widgets.slint";
import { CakruTitle } from "ui/layout_ru.slint";
import { CakruInputField, CakruButton } from "ui/style_ru.slint";

export component CakruApp inherits Window {
    in-out property <string> name-input <=> input-field.text;
    in-out property <string> message: "";
    in-out property <bool> is-dark: true; 
    callback say-hello;

    // PERBAIKAN: Mengganti 100__ menjadi 100% (bebas dari error typo)
    background: root.is-dark ? 
        @linear-gradient(180deg, #1a1a2e 0%, #16161a 100%) : 
        @linear-gradient(180deg, #f5f7fa 0%, #e4e8f0 100%);

    VerticalLayout {
        padding-left: root.safe-area-insets.left;
        padding-right: root.safe-area-insets.right;
        padding-top: root.safe-area-insets.top;
        padding-bottom: root.safe-area-insets.bottom;

        ScrollView {
            mouse-drag-pan-enabled: true;
            width: 100%;
            height: 100%;

            VerticalBox {
                alignment: center;
                padding: 30px;
                spacing: 25px;

                CakruTitle { 
                    text: "CakRu"; 
                }

                input-field := CakruInputField {
                    label-text: "Nama Lengkap";
                    placeholder: "Ketik nama di sini...";
                    is-dark: root.is-dark;
                }

                CakruButton {
                    text: "SAPA SAYA";
                    is-dark: root.is-dark;
                    clicked => { root.say-hello(); }
                }

                Text {
                    text: root.message;
                    font-size: 20px;
                    color: root.is-dark ? #4caf50 : #2e7d32;
                    horizontal-alignment: center;
                    wrap: TextWrap.word-wrap;
                    visible: root.message != "";
                }
            }
        }
    }
}
