import { VerticalBox, Button, LineEdit, ScrollView } from "std-widgets.slint";

export component CakruApp inherits Window {
    in-out property <string> name-input: "";
    in-out property <string> message: "";
    callback say-hello;

    // Pembungkus utama dipindahkan ke elemen layout agar padding safe-area bekerja dengan benar
    VerticalLayout {
        padding-left: root.safe-area-insets.left;
        padding-right: root.safe-area-insets.right;
        padding-top: root.safe-area-insets.top;
        padding-bottom: root.safe-area-insets.bottom;

        ScrollView {
            mouse-drag-pan-enabled: true;
            width: 100%;
            height: 100%;

            VerticalBox {
                alignment: center;
                padding: 20px;
                spacing: 20px;

                Text {
                    text: "Masukkan Nama Anda";
                    font-size: 24px;
                    color: #2196f3;
                    horizontal-alignment: center;
                }

                VerticalLayout {
                    spacing: 5px;
                    
                    label := Text {
                        text: "Nama Lengkap";
                        font-size: 14px;
                        color: #757575;
                        horizontal-alignment: left;
                    }

                    LineEdit {
                        placeholder-text: "Ketik nama di sini...";
                        text: name-input;
                        accessible-label: label.text;
                        edited => { name-input = self.text; }
                    }
                }

                Button {
                    text: "Sapa Saya";
                    clicked => { say-hello(); }
                }

                Text {
                    text: message;
                    font-size: 20px;
                    color: #4caf50;
                    horizontal-alignment: center;
                    // PERBAIKAN: Menggunakan enum TextWrap yang benar di Slint
                    wrap: TextWrap.word-wrap;
                    visible: message != "";
                }
            }
        }
    }
}
