import { VerticalBox, Button, LineEdit, ScrollView, HorizontalBox } from "std-widgets.slint";

export component CakruApp inherits Window {
    in-out property <string> name-input: "";
    in-out property <string> message: "";
    in-out property <int> active-tab: 0; 
    callback say-hello;

    VerticalLayout {
        padding-left: root.safe-area-insets.left;
        padding-right: root.safe-area-insets.right;
        padding-top: root.safe-area-insets.top;
        padding-bottom: root.safe-area-insets.bottom;

        // TOP APP BAR
        Rectangle {
            height: 56px;
            background: #2196f3;
            HorizontalLayout {
                padding-left: 15px;
                Text {
                    text: "Cakru App";
                    font-size: 20px;
                    color: white;
                    vertical-alignment: center;
                }
            }
        }

        // AREA KONTEN UTAMA DENGAN OPTIMASI ANIMASI
        Rectangle {
            vertical-stretch: 1;

            // HALAMAN 1: HOME
            home-page := VerticalBox {
                padding: 20px;
                spacing: 20px;
                opacity: root.active-tab == 0 ? 1 : 0;
                visible: root.active-tab == 0; // Tetap gunakan visible untuk performa rendering

                animate opacity { duration: 200ms; easing: ease-in-out; }

                Text {
                    text: "Masukkan Nama Anda";
                    font-size: 24px;
                    color: #2196f3;
                    horizontal-alignment: center;
                }

                VerticalLayout {
                    spacing: 5px;
                    label := Text { text: "Nama Lengkap"; font-size: 14px; color: #757575; }
                    LineEdit {
                        placeholder-text: "Ketik nama di sini...";
                        text: name-input;
                        accessible-label: label.text;
                        edited => { name-input = self.text; }
                    }
                }

                Button {
                    text: "Sapa Saya";
                    clicked => { say-hello(); }
                }

                Text {
                    text: message;
                    font-size: 20px;
                    color: #4caf50;
                    horizontal-alignment: center;
                    wrap: TextWrap.word-wrap;
                    visible: message != "";
                }
            }

            // HALAMAN 2: INFO
            info-page := VerticalBox {
                padding: 20px;
                spacing: 15px;
                alignment: center;
                opacity: root.active-tab == 1 ? 1 : 0;
                visible: root.active-tab == 1;

                animate opacity { duration: 200ms; easing: ease-in-out; }

                Text {
                    text: "ℹ️ Tentang Aplikasi";
                    font-size: 22px;
                    color: #2196f3;
                    horizontal-alignment: center;
                }

                Text {
                    text: "Aplikasi ini dibuat menggunakan Slint Framework dan Rust UI Engine. Sangat ringan, cepat, dan responsif di Android!";
                    font-size: 16px;
                    horizontal-alignment: center;
                    wrap: TextWrap.word-wrap;
                }
            }
        }

        // BOTTOM NAVIGATION BAR DENGAN ANIMASI SENTUHAN
        Rectangle {
            height: 65px;
            background: #f5f5f5;

            HorizontalLayout {
                alignment: space-around;

                // TAB 1
                Rectangle {
                    background: root.active-tab == 0 ? #e3f2fd : Colors.transparent;
                    border-radius: 8px;
                    animate background { duration: 150ms; }
                    
                    HorizontalLayout {
                        padding: 10px;
                        Text {
                            text: "🏠 Home";
                            font-size: 16px;
                            color: root.active-tab == 0 ? #2196f3 : #757575;
                        }
                    }
                    TouchArea { clicked => { root.active-tab = 0; } }
                }

                // TAB 2
                Rectangle {
                    background: root.active-tab == 1 ? #e3f2fd : Colors.transparent;
                    border-radius: 8px;
                    animate background { duration: 150ms; }
                    
                    HorizontalLayout {
                        padding: 10px;
                        Text {
                            text: "ℹ️ Info";
                            font-size: 16px;
                            color: root.active-tab == 1 ? #2196f3 : #757575;
                        }
                    }
                    TouchArea { clicked => { root.active-tab = 1; } }
                }
            }
        }
    }
}
