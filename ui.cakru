Navbar {
    id: "top_nav"
    Row {
        Text {
            id: "nav_menu"
            text: "☰"
        }
        Input {
            id: "nav_search"
            placeholder: "Telusuri catatan..."
        }
        Text {
            id: "nav_setting"
            text: "⚙"
        }
    }
}

Text {
    id: "output_pesan"
    text: ""
}
Text {
    id: "sub_judul"
    text: "Do you want to update this app?"
    size: "20"
}

Row {
    Button {
        id: "btn_cancel"
        text: "Cancel"
    }
    Button {
        id: "btn_update"
        text: "Update"
    }
}

