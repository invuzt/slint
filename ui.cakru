Navbar {
    id: "top_nav"
    Row {
        Text {
            id: "nav_menu"
            text: "☰"
        }
        Input {
            id: "nav_search"
            placeholder: "Cari No. DI.208 / Tahun / Gudang..."
        }
        Text {
            id: "nav_setting"
            text: "⚙"
        }
    }
}

Text {
    id: "sub_judul"
    text: "Pencatatan Cepat ArZip DI.208:"
    size: "18"
}

Row {
    Input {
        id: "input_gudang"
        placeholder: "Pilih Gudang (Tap untuk Opsi)"
    }
    Input {
        id: "input_kardus"
        placeholder: "No. Rak / Kardus"
    }
}

Row {
    Input {
        id: "input_range"
        placeholder: "No DI.208 (Contoh: 3526 3550)"
    }
    Input {
        id: "input_tahun"
        placeholder: "Pilih Tahun (Tap untuk Opsi)"
    }
}

Row {
    Button {
        id: "btn_simpan"
        text: "Simpan & Lanjutkan"
    }
}

Text {
    id: "output_pesan"
    text: "Status: Siap menerima entri data."
}

# --- BAGIAN COMPONENT TABEL / LIST VIEW LAZY DATA ---
Text {
    id: "tabel_judul"
    text: "\n📋 DATA TERBARU / HASIL PENCARIAN:"
    size: "16"
    color: "#0067FF"
}

Text {
    id: "tabel_konten"
    text: "Memuat data..."
    size: "14"
}
