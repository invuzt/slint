# --- MENU SAMPING / DRAWER PANEL ---
Drawer {
    id: "side_drawer"
    Text {
        id: "panel_title"
        text: "ArZip Registry"
        size: "24"
        color: "#1C1B1F"
    }
    Text {
        id: "menu_input"
        text: "📝 Catat Warkah Baru"
        size: "16"
    }
    Text {
        id: "menu_share"
        text: "🔄 Bagikan Database (.db)"
        size: "16"
    }
    Text {
        id: "menu_info"
        text: "ℹ️ Engine: Rust + SQLite"
        size: "14"
        color: "#79747E"
    }
}

# --- NAVBAR UTAMA ---
Navbar {
    id: "top_nav"
    Row {
        Text {
            id: "nav_menu"
            text: "☰"
        }
        Input {
            id: "nav_search"
            placeholder: "Cari No. DI.208 / Tahun / Gudang..."
        }
        Text {
            id: "nav_setting"
            text: "⚙"
        }
    }
}

# --- FORM UTAMA ---
Text {
    id: "sub_judul"
    text: "Pencatatan Cepat ArZip DI.208:"
    size: "18"
}

Row {
    Input {
        id: "input_gudang"
        placeholder: "Pilih Gudang (Tap untuk Opsi)"
    }
    Input {
        id: "input_kardus"
        placeholder: "No. Rak / Kardus"
    }
}

Row {
    Input {
        id: "input_range"
        placeholder: "No DI.208 (Contoh: 3526 3550)"
    }
    Input {
        id: "input_tahun"
        placeholder: "Pilih Tahun (Tap untuk Opsi)"
    }
}

Row {
    Button {
        id: "btn_simpan"
        text: "Simpan & Lanjutkan"
    }
}

Text {
    id: "output_pesan"
    text: "Status: Siap menerima entri data."
}

# --- TABEL UNTUK LIVE PREVIEW ---
Text {
    id: "tabel_judul"
    text: "\n📋 DATA TERBARU / HASIL PENCARIAN:"
    size: "16"
    color: "#0067FF"
}

Text {
    id: "tabel_konten"
    text: "Memuat data..."
    size: "14"
}
