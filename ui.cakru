Navbar {
    id: "top_nav"
    Row {
        Text {
            id: "nav_menu"
            text: "☰"
        }
        Input {
            id: "nav_search"
            placeholder: "Cari Tahun atau No. DI.208..."
        }
        Text {
            id: "nav_setting"
            text: "⚙"
        }
    }
}

Text {
    id: "sub_judul"
    text: "Form Input Arsip Kardus Baru:"
    size: "18"
}

Row {
    Input {
        id: "input_kardus"
        placeholder: "Lokasi/No. Kardus (Contoh: Rak-A1)"
    }
}

Row {
    Input {
        id: "input_range"
        placeholder: "Rentang DI.208 (Contoh: 3526-3550)"
    }
    Input {
        id: "input_tahun"
        placeholder: "Tahun Warkah"
    }
}

Row {
    Button {
        id: "btn_simpan"
        text: "Simpan Kardus ke Rust"
    }
}

Text {
    id: "output_pesan"
    text: "Status: Siap melakukan inventarisasi warkah."
}
