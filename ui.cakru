App {
    Text {
        id: "judul"
        text: "CakRu App Kanan-Kiri"
        size: "28"
        color: "#2196F3"
    }
    
    
    Input {
        id: "input_nama"
        placeholder: "Ketik sesuatu di sini..."
    }
    
    Text {
        id: "output_pesan"
        text: "Menunggu aksi..."
        size: "20"
        color: "#4CAF50"
    }
    Row {
        Button {
            id: "btn_kiri"
            text: "Tombol Kiri"
            action: "klik_kiri"
        }
        Button {
            id: "btn_kanan"
            text: "Tombol Kanan"
            action: "klik_kanan"
        }
    }
}
