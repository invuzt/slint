Navbar {
    id: "top_nav"
    Row {
        Text {
            id: "nav_menu"
            text: "☰"
        }
        Input {
            id: "nav_search"
            placeholder: "Cari No. DI.208 / Tahun / Gudang..."
        }
        Text {
            id: "nav_setting"
            text: "⚙"
        }
    }
}

Text {
    id: "sub_judul"
    text: "Pilih Gudang & Lokasi Penyimpanan:"
    size: "18"
}

Row {
    Input {
        id: "input_gudang"
        placeholder: "Gudang (Lama / Baru Lnt 1 / Baru Lnt 2)"
    }
    Input {
        id: "input_kardus"
        placeholder: "Detail Posisi / No. Rak"
    }
}

Row {
    Input {
        id: "input_range"
        placeholder: "Rentang DI.208 (Contoh: 3526-3550)"
    }
    Input {
        id: "input_tahun"
        placeholder: "Tahun Warkah"
    }
}

Row {
    Button {
        id: "btn_simpan"
        text: "Simpan Kardus ke Rust"
    }
}

Text {
    id: "output_pesan"
    text: "Status: Siap memetakan 3 lokasi gudang warkah."
}
